        "lychee",
        "markdownlint-cli2",
        "npm:markdown-link-check",
        "npm:markdown-magic",
        "npm:tree-node-cli",
        "omnictl",
        "opentofu",
        "pandoc",
        "pipx:mitmproxy",
        "pipx:rumdl",
        "pkl",
        "pre-commit",
        "prek",
        "prettier",
        "rg",
        "ripgrep",
        "ruff",
        "shellcheck",
        "shfmt",
        "taplo",
