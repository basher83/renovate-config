        "ruff",
        "shellcheck",
        "shfmt",
        "taplo",
        "terraform-docs",
        "tflint",
        "uv",
        "watchexec",
        "yamlfmt",
        "yamllint",
        "yq"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchCurrentVersion": "/^0\\./",
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Do not auto-merge allowlisted mise tool major updates (1.x+ semver)",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "act",
        "actionlint",
        "age",
        "aqua:koalaman/shellcheck",
        "cargo:cargo-audit",
        "cargo:cargo-zigbuild",
        "cosign",
        "eza",
        "fd",
        "fnox",
        "gh-aw",
        "git-cliff",
        "helm",
