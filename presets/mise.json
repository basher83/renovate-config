{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "mise preset - language runtimes vs allowlisted tools; conservative default for unlisted plugins (renovate-config#132, D017)",
  "packageRules": [
    {
      "description": "Group mise-managed language runtimes separately from tools",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "python",
        "node",
        "go",
        "ruby",
        "java",
        "erlang",
        "elixir",
        "php",
        "scala",
        "kotlin",
        "deno",
        "bun",
        "rust"
      ],
      "groupName": "mise language runtimes",
      "groupSlug": "mise-runtimes"
    },
    {
      "description": "Require Dependency Dashboard approval for mise language runtime minor and major updates in a separate group so approval does not hold back runtime patches",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "python",
        "node",
        "go",
        "ruby",
        "java",
        "erlang",
        "elixir",
        "php",
        "scala",
        "kotlin",
        "deno",
        "bun",
        "rust"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "mise language runtimes (approval)",
      "groupSlug": "mise-runtimes-approval"
    },
    {
      "description": "Auto-merge mise language runtime patch updates after minimum release age",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "python",
        "node",
        "go",
        "ruby",
        "java",
        "erlang",
        "elixir",
        "php",
        "scala",
        "kotlin",
        "deno",
        "bun",
        "rust"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Require approval for minor and major updates of mise plugins outside the runtime list and tool allowlist; their patches are neither grouped nor automerged",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "!python",
        "!node",
        "!go",
        "!ruby",
        "!java",
        "!erlang",
        "!elixir",
        "!php",
        "!scala",
        "!kotlin",
        "!deno",
        "!bun",
        "!rust",
        "!act",
        "!actionlint",
        "!age",
        "!aqua:koalaman/shellcheck",
        "!cargo:cargo-audit",
        "!cargo:cargo-zigbuild",
        "!cosign",
        "!eza",
        "!fd",
        "!fnox",
        "!gh-aw",
        "!git-cliff",
        "!helm",
        "!hk",
        "!jq",
        "!kubeconform",
        "!lychee",
        "!markdownlint-cli2",
        "!npm:markdown-link-check",
        "!npm:markdown-magic",
        "!npm:tree-node-cli",
        "!omnictl",
        "!opentofu",
        "!pandoc",
        "!pipx:mitmproxy",
        "!pipx:rumdl",
        "!pkl",
        "!pre-commit",
        "!prek",
        "!prettier",
        "!rg",
        "!ripgrep",
        "!ruff",
        "!shellcheck",
        "!shfmt",
        "!taplo",
        "!terraform-docs",
        "!tflint",
        "!uv",
        "!watchexec",
        "!yamlfmt",
        "!yamllint",
        "!yq"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "mise plugins (unspecified)",
      "groupSlug": "mise-unspecified"
    },
    {
      "description": "Group allowlisted mise development tools",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "act",
        "actionlint",
        "age",
        "aqua:koalaman/shellcheck",
        "cargo:cargo-audit",
        "cargo:cargo-zigbuild",
        "cosign",
        "eza",
        "fd",
        "fnox",
        "gh-aw",
        "git-cliff",
        "helm",
        "hk",
        "jq",
        "kubeconform",
        "lychee",
        "markdownlint-cli2",
        "npm:markdown-link-check",
        "npm:markdown-magic",
        "npm:tree-node-cli",
        "omnictl",
        "opentofu",
        "pandoc",
        "pipx:mitmproxy",
        "pipx:rumdl",
        "pkl",
        "pre-commit",
        "prek",
        "prettier",
        "rg",
        "ripgrep",
        "ruff",
        "shellcheck",
        "shfmt",
        "taplo",
        "terraform-docs",
        "tflint",
        "uv",
        "watchexec",
        "yamlfmt",
        "yamllint",
        "yq"
      ],
      "groupName": "mise tools",
      "groupSlug": "mise-tools"
    },
    {
      "description": "Require approval for allowlisted mise tools on 0.x semver minor and major (0.y bumps are breaking) in a separate group so approval does not hold back automerged tool updates",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "act",
        "actionlint",
        "age",
        "aqua:koalaman/shellcheck",
        "cargo:cargo-audit",
        "cargo:cargo-zigbuild",
        "cosign",
        "eza",
        "fd",
        "fnox",
        "gh-aw",
        "git-cliff",
        "helm",
        "hk",
        "jq",
        "kubeconform",
        "lychee",
        "markdownlint-cli2",
        "npm:markdown-link-check",
        "npm:markdown-magic",
        "npm:tree-node-cli",
        "omnictl",
        "opentofu",
        "pandoc",
        "pipx:mitmproxy",
        "pipx:rumdl",
        "pkl",
        "pre-commit",
        "prek",
        "prettier",
        "rg",
        "ripgrep",
        "ruff",
        "shellcheck",
        "shfmt",
        "taplo",
        "terraform-docs",
        "tflint",
        "uv",
        "watchexec",
        "yamlfmt",
        "yamllint",
        "yq"
      ],
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false,
      "groupName": "mise tools (approval)",
      "groupSlug": "mise-tools-approval"
    },
    {
      "description": "Auto-merge allowlisted mise tool patch and minor updates after minimum release age (1.x+ only for minor)",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "act",
        "actionlint",
        "age",
        "aqua:koalaman/shellcheck",
        "cargo:cargo-audit",
        "cargo:cargo-zigbuild",
        "cosign",
        "eza",
        "fd",
        "fnox",
        "gh-aw",
        "git-cliff",
        "helm",
        "hk",
        "jq",
        "kubeconform",
        "lychee",
        "markdownlint-cli2",
        "npm:markdown-link-check",
        "npm:markdown-magic",
        "npm:tree-node-cli",
        "omnictl",
        "opentofu",
        "pandoc",
        "pipx:mitmproxy",
        "pipx:rumdl",
        "pkl",
        "pre-commit",
        "prek",
        "prettier",
        "rg",
        "ripgrep",
        "ruff",
        "shellcheck",
        "shfmt",
        "taplo",
        "terraform-docs",
        "tflint",
        "uv",
        "watchexec",
        "yamlfmt",
        "yamllint",
        "yq"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Auto-merge allowlisted mise tool patch updates on 0.x semver after minimum release age",
      "matchManagers": ["mise"],
      "matchDepNames": [
        "act",
        "actionlint",
        "age",
        "aqua:koalaman/shellcheck",
        "cargo:cargo-audit",
        "cargo:cargo-zigbuild",
        "cosign",
        "eza",
